{
  "manifest_version": 3,
  "name": "Alfred AI",
  "version": "1.0",
  "description": "An AI assistant that can see and interact with your current browser tab.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Alfred AI"
  }
}
