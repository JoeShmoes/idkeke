{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "description": "Nexaris Module - Personal OS",
  "author": "Nexaris",
  "scripts": {
    "dev": "next dev -p 9002",
    "build": "next build",
    "clean:dist": "powershell -NoProfile -Command \"if (Test-Path 'dist') { Remove-Item -Path 'dist' -Recurse -Force }\"",
    "prepare:packager": "powershell -NoProfile -Command \"if (Test-Path '.next') { Remove-Item -Path '.next' -Recurse -Force }; if (Test-Path 'build\\\\cache') { Remove-Item -Path 'build\\\\cache' -Recurse -Force }; if (Test-Path 'build\\\\server') { Remove-Item -Path 'build\\\\server' -Recurse -Force }\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build",
    "build:desktop": "npm run build && electron-builder -w",
    "build:packager": "npm run build && npm run prepare:packager && electron-packager . NexarisModule --platform=win32 --arch=x64 --out=dist-app --overwrite --prune=true --asar --ignore=\"node_modules|dist|dist-app|dist-app-clean|installer|\\.git|out|build\\\\cache|build\\\\server|\\\\.next\"",
    "build:installer:inno": "iscc installer\\nexaris-media.iss"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.87.1",
    "@types/react-beautiful-dnd": "^13.1.8",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "framer-motion": "^12.23.26",
    "js-base64": "^3.7.8",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "next": "15.3.3",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.68.0",
    "react-hotkeys-hook": "^4.6.2",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.nexaris.module",
    "productName": "Nexaris Module",
    "icon": ".idx\\icon.png",
    "compression": "maximum",
    "directories": {
      "output": "dist-new"
    },
    "files": [
      "electron/**",
      "build/**",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "NexarisModule-Setup-${version}.exe"
    },
    "nsis": {
      "installerIcon": ".idx\\icon.png",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.0.10",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
